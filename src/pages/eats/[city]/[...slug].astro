---
// src/pages/eats/[city]/[...slug].astro — Individual article page
// Handles /eats/puli/slug/ for all cities and all slugs

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allEats = await getCollection('eats', ({ data }) => !data.draft);

  return allEats.map((post) => {
    const city = post.data.locationSlug;
    // Strip directories and .md extension from slug for clean URLs
    const rawSlug = post.id.split('/').pop() || post.id;
    const slug = rawSlug.replace(/\.md$/, '');

    return {
      params: { city, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = import.meta.env.SITE || 'https://path-site.com';
const canonicalUrl = post.data.canonicalUrl ?? new URL(Astro.url.pathname, siteUrl).href;
const seoTitle = post.data.seoTitle
  ? `${post.data.seoTitle} — PATH`
  : `${post.data.title} — PATH`;
const ogImageSource = post.data.ogImage ?? post.data.coverImage;
const ogImage = ogImageSource
  ? new URL(ogImageSource, siteUrl).href
  : undefined;
---

<BaseLayout
  title={seoTitle}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogTitle={post.data.ogTitle}
  ogDescription={post.data.ogDescription}
  ogImageAlt={post.data.ogImageAlt ?? post.data.coverAlt}
  ogType="article"
  noindex={post.data.noindex}
  articleData={{
    pubDate: post.data.pubDate,
    location: post.data.locationName,
    keyword: post.data.keyword,
    secondaryKeywords: post.data.secondaryKeywords,
  }}
>
  <article>
    <header class="article-header">
      <h1 class="article-title">{post.data.title}</h1>
      <div class="article-meta">
        <span>{post.data.locationName}</span>
        <span>·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString('zh-TW', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>
    </header>

    {post.data.coverImage && (
      <img
        src={post.data.coverImage}
        alt={post.data.coverAlt ?? post.data.title}
        class="article-cover"
        loading="lazy"
        decoding="async"
      />
    )}

    <div class="article-body">
      <Content />
    </div>
  </article>
</BaseLayout>
